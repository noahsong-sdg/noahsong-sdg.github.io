{% set currentUrl %}{{ page.url }}{% endset %}

<nav>
  <ul role="list">
    <li>
      <a {% if currentUrl === '/' %}aria-current="page"{% endif %} href="{{ '/' | url }}">noah</a>
    </li>

    <li>
      <a {% if currentUrl === '/projects/' %}aria-current="page"{% endif %} href="{{ '/projects/' | url }}">projects</a>
    </li>
    <li>
      <a {% if currentUrl.startsWith('/lists/') %}aria-current="page"{% endif %} href="{{ '/lists/' | url }}">lists</a>
    </li>
    <li>
      <a {% if currentUrl.startsWith('/writing/') %}aria-current="page"{% endif %} href="{{ '/writing/' | url }}">writing</a>
    </li>
  </ul>
</nav>
