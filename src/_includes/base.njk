<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}{% if page.url != '/' %} | {{ meta.siteName }}{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="canonical" href="{{ meta.siteUrl }}{{ page.url }}">
  <meta property="og:title" content="{{ title }}{% if page.url != '/' %} | {{ meta.siteName }}{% endif %}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ meta.siteUrl }}{{ page.url }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title }}{% if page.url != '/' %} | {{ meta.siteName }}{% endif %}">
  {% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  {% include "nav.njk" %}

  {{ content | safe }}

  <footer>
    <div>
      <p>&copy; {% year %} {{ meta.siteName }}{% if meta.authorName %} • {{ meta.authorName }}{% endif %}</p>
    </div>
  </footer>

</body>
</html>
